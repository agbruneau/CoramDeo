# Base de données de l'outillage local Ruflo / RuVector (hors site web)
ruvector.db

# Copies de sauvegarde Windows (« - Copie »)
* - Copie*

# Outillage local Claude Code (config propre à la machine, verrous transitoires),
# sauf les skills versionnés et la bibliothèque partagée dont leurs scripts dépendent.
**/.claude/*
!**/.claude/skills/
!**/.claude/shared/

# Cache de bytecode Python (artefacts de build)
__pycache__/
*.pyc

# Artefacts transitoires des skills sermon-* (JSON intermédiaires)
_temp.json
serie-de-predications-temp.json
